#include "resource.h"
#include "version.h"
#include <winver.h>

IDI_APP ICON "../res/FastFiles.ico"
IDR_LANG RCDATA "../res/lang.txt"

VS_VERSION_INFO VERSIONINFO
FILEVERSION FF_VER_NUM
PRODUCTVERSION FF_VER_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "FastFiles"
            VALUE "FileDescription", "FastFiles"
            VALUE "FileVersion", FF_VER_STR
            VALUE "InternalName", "FastFiles"
            VALUE "OriginalFilename", "FastFiles.exe"
            VALUE "ProductName", "FastFiles"
            VALUE "ProductVersion", FF_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END

